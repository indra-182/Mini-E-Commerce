{
  "name": "mini-e-commerce",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "db:format": "prisma format",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed-if-empty": "tsx prisma/seed.ts",
    "db:reset:dev": "tsx prisma/scripts/reset-database.ts dev",
    "db:reset:test": "tsx prisma/scripts/reset-database.ts test",
    "api:dev": "pnpm --filter @mini-ecommerce/api dev",
    "api:build": "pnpm --filter @mini-ecommerce/api build",
    "api:typecheck": "pnpm --filter @mini-ecommerce/api typecheck",
    "api:lint": "pnpm --filter @mini-ecommerce/api lint",
    "api:test": "pnpm --filter @mini-ecommerce/api test",
    "api:test:integration": "pnpm --filter @mini-ecommerce/api test:integration",
    "api:openapi": "pnpm --filter @mini-ecommerce/api openapi:generate",
    "api:assemble-static": "pnpm --filter @mini-ecommerce/api assemble-static",
    "web:dev": "pnpm --filter @mini-ecommerce/web dev",
    "web:build": "pnpm --filter @mini-ecommerce/web build",
    "web:typecheck": "pnpm --filter @mini-ecommerce/web typecheck",
    "web:lint": "pnpm --filter @mini-ecommerce/web lint",
    "web:format": "pnpm --filter @mini-ecommerce/web format",
    "format": "pnpm web:format",
    "lint": "pnpm api:lint && pnpm web:lint",
    "typecheck:all": "pnpm typecheck && pnpm api:typecheck && pnpm web:typecheck",
    "test:unit": "pnpm test && pnpm api:test && pnpm --filter @mini-ecommerce/web test",
    "test:integration": "pnpm test:db && pnpm api:test:integration",
    "test:db:setup": "pnpm db:reset:test && pnpm db:seed-if-empty",
    "openapi:check": "pnpm api:openapi && git diff --exit-code -- apps/api/openapi.json packages/api-types/src/generated.ts",
    "build:production": "pnpm web:build && pnpm api:build && pnpm api:assemble-static",
    "start:production": "node scripts/start-production.mjs",
    "smoke:production": "tsx scripts/smoke-production.ts",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "verify": "tsx scripts/verify.ts",
    "test": "tsx --test packages/content-fixtures/src/index.test.ts",
    "test:db": "tsx --test prisma/tests/schema.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@mini-ecommerce/content-fixtures": "workspace:*",
    "@prisma/client": "^6.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.0.0",
    "prisma": "^6.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
